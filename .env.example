# TOML file containing API keys. If missing or empty, auth is disabled.
API_KEYS_FILE=api-keys.toml

# Keep this at 1 for the Leaseweb VPS result profile.
OCR_CONCURRENCY=1

# 5 MiB default.
MAX_UPLOAD_BYTES=5242880

# Expose Prometheus metrics at /metrics.
ENABLE_METRICS=true
METRICS_REQUIRE_API_KEY=false

# Bank slips are upright; disabling classifier improves latency.
RAPIDOCR_USE_CLS=false

# Optional future web UI mount.
# WEBUI_DIR=/app/webui
